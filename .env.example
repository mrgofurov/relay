# ==========================================
# Relay Environment Configuration
# ==========================================

# Ports
RELAY_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=relay
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/relay

# Security
SECRET_KEY=relay_production_super_secret_jwt_key_change_me_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Git Integration
GITHUB_WEBHOOK_SECRET=

# Public URLs (used by frontend)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws
